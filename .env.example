# memoRABLE environment configuration
#
# The deterministic experience (JSON / Text / Markdown import, six Memory
# Blocks, Web / Email / Document outputs) needs NO environment variables and
# makes NO network requests.
#
# AI improvement is optional and DISABLED by default. It is only reachable when
# explicitly enabled here AND a provider key is configured on the server.
# Public deployments should keep ENABLE_AI=false unless platform rate/spend
# controls are in place.

# Set to "true" to expose the server-side AI improvement route. Default: false.
ENABLE_AI=false

# Server-only OpenAI-compatible API key. Never expose this to the browser.
# Only required when ENABLE_AI=true.
OPENAI_API_KEY=

# Optional OpenAI-compatible base URL and model overrides.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
